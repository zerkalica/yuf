$yuf_svg_video $mol_svg_image
	dom_name \foreignObject
	style *
		^
		transform <= tile_transform null string
	attr *
		^
		href null
	sub /$mol_view
		<= Player $yuf_svg_video_player
			autoplay <= autoplay true
			controls <= controls false
			loop <= loop true
			muted <= muted false
			poster <= poster \
			inline <= inline true
			uri <= uri \
			stream <= stream null
			duration => duration
			playing? => playing?
			volume? => volume?
			fullscreen? => fullscreen?
			preload <= preload \metadata
			time? => time?
			click_event? <=> click_event? null
			error? <=> error? null
			info? <=> info? null HTMLVideoElement

$yuf_svg_video_player $mol_video_player
	fullscreen? false
	info? null HTMLVideoElement
	-
	attr *
		^
		xmlns \http://www.w3.org/1999/xhtml
		preload <= preload \metadata
	event *
		^
		loadedmetadata? <=> metadata_event? null
		click? <=> click_event? null
		error? <=> error? null
