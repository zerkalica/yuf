$yuf_sj_ui_device_link $yuf_link
	name \
	model $yuf_sj_ui_device_info_model
		id => id
		device_type => device_type
		device_status => device_status
		uptime => uptime
		serial => serial
		firmware_version => version
	minimal_height 168
	sub /
		<= Description $mol_view sub /
			<= Title $mol_view sub /
				<= name_id <= id
			<= Status_block $mol_view sub /
				<= Status $yuf_sj_ui_device_status
					value <= device_status
		<= Footer $mol_view sub /
			<= Device_type_label $yuf_sj_ui_device_link_label
				title <= device_type_label @ \Type
				content / <= device_type_formatted \
			<= Uptime_label $yuf_sj_ui_device_link_label
				title <= uptime_label @ \Start
				content / <= Uptime $yuf_time_card
					moment <= uptime
					hint <= uptime_hint @ \First data at
					format \short
			<= Version_label $yuf_sj_ui_device_link_label
				title <= version_label @ \Ver
				content / <= version
			^ serial_content /
				<= Serial_label $yuf_sj_ui_device_link_label
					title <= serial_title @ \Serial number
					content / <= serial

$yuf_sj_ui_device_link_label $mol_labeler
	Label $mol_view sub <= label
