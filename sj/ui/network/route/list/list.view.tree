$yuf_sj_ui_network_route_list $yuf_sj_ui_book_list
	title @ \Routes
	tools /
		^ tools_foot /
			<= Close null
	routes $yuf_sj_ui_network_route_store
		ids => ids
		by_id* => by_id*
	Row*0 $yuf_sj_ui_network_route_form
		model <= by_id*
		remove_event? <=> remove_event*? null
	Row_draft*0 $yuf_sj_ui_network_route_form
		draft true
		model <= by_id*
		remove_event? <=> remove_event*?
