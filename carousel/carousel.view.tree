$yuf_carousel $mol_view
	index? 0
	scroll_x? 0
	auto_scroll true
	minimal_height 120
	ids /string - ids or urls
	sub <= images /$mol_view
		<= Empty*0 $mol_icon_camera_off
		<= Image*0 $mol_image
			minimal_height 120
			uri <= url* \
	event *
		^
		mousemove? <=> event_move? null
		scroll? <=> event_scroll? null
