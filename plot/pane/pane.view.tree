$yuf_plot_pane $mol_plot_pane
	selected_key? null readonly[note_id:string,point_index:number]
	note_id_selected? \
	-
	points*? /readonly[number,number]
	point*? null readonly[number,number]
	-
	action_point_normalized null $mol_vector_2d<number>
	action_point_delta null $mol_vector_2d<number>
	points_move? null 'start'|'move'|'shift'
	-
	visible_center $mol_vector_2d<number>
	-
	event *
		^
		pointerup? <=> outside_click_event? null
	style *
		^
		filter <= filter \brightness({brightness}%) contrast({contrast}%)
	shift_default $mol_vector_2d<number> /
		0
		0
	gap_hor 40
	gap_vert 0
	center? null
	allow_draw false
	-
	zoom_limit $mol_vector_range<number> /
		<= zoom_min .8
		<= zoom_max 12
	zoom_reset? null
	zoom_default_factory 1
	zoom_relative? <=> zoom?
	-
	size <= image_size_safe <= image_size $mol_vector_2d<number> /
		0
		0
	-
	rotation? 0
	brightness? 0
	contrast? 0
	-
	sub /
		^
		^ defs_content /$mol_view <= Defs $mol_svg
			dom_name \defs
			sub <= defs /$mol_svg
	graphs /$mol_plot_graph
		<= Tiles $yuf_plot_tiles
			level_override 0
			tile_type* <= tile_type* <= type \image
			tile_uri_actual* <= tile_uri* <= url \
			image_size <= image_size_safe
