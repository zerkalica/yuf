$yuf_avatar_editor $mol_view
	value_data_url? \
	value_blob? null Blob
	size_max /number
		<= size_max_x 512
		<= size_max_y 512
	canvas $yuf_canvas_pipe
		quality .8
		image_type <= image_type \image/jpeg
	sub /$mol_view
		<= Toolbar $mol_toolbar items /
			<= Upload $yuf_attach2
				files? <=> blobs? /Blob
				accept <= accept \.png, .jpg, .jpeg
			<= Crop_enabled $mol_check_icon
				Icon <= Crop_icon $mol_icon_crop
				enabled <= url_exists false
				checked? <=> instrument_enabled*crop? false
				hint <= crop_hint @ \Crop
			<= Undo_redo $mol_view sub <= undo_redo_content /$mol_view
				<= Undo $mol_button_minor
					hint <= undo_hint @ \Undo
					enabled <= undo_enabled false
					sub / <= Undo_icon $mol_icon_undo
					click? <=> undo? null
			<= Actions $mol_view sub <= actions_content /$mol_view
				<= Accept $mol_button_minor
					sub / <= Accept_icon $mol_icon_check
					hint <= accept_hint @ \Accept
					click? <=> instrument_accept? null
				<= Decline $mol_button_minor
					sub / <= Decline_icon $mol_icon_close
					hint <= decline_hint @ \Decline
					click? <=> instrument_close? null
		^ pane_content /$mol_view <= Pane $yuf_avatar_pane
			url <= current_url \
			points* => points*
			note_id_selected? => note_id_selected?
