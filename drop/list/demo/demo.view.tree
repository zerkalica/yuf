$yuf_drop_list_demo $mol_example_large
	title \DnD catalog
	sub /
		<= Calatog $yuf_drop_list_demo_catalog
			menu_title <= title
			param \dnd
	tags /
		\drag
		\dragndrop
		\reorder
		\transfer
		\page
		\menu
		\navigation
	aspects /
		\Widget/Plugin
		\Drag'n'Drop

$yuf_drop_list_demo_catalog $mol_book2_catalog
	items_max 50
	menu_tools /
		<= Errors_on $mol_check_box
			title <= errors_on_title @ \Error
			checked? <=> errors_on? false
	Menu_links $yuf_drop_list
		Empty <= Menu_links_empty
		param <= param
		ids_actual? <=> ids_actual? /string
		-
		id* <= id* \
		Item* <= Menu_item* $mol_view sub /
			^ menu_item_content*
			<= Status*
		-
		Status* => Status*
		-
		ids_current => spread_ids
		ids_filtered <= spread_ids_filtered
	menu_link_content* /$mol_view_content
		<= Menu_link_title*
	spread_title* <= id*
