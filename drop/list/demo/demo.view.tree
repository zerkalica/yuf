$yuf_drop_list_demo $mol_example_large
	title \DnD
	sub /
		<= Book $mol_book2 pages /
			<= Catalog $yuf_drop_list_demo_catalog
				menu_title \DnD - status in top
				param \dnd
			- <= Catalog2 $yuf_drop_list_demo_catalog
				menu_title \DnD - Per item status
				param \dnd_per_item
				status_content /
				-
				Item_status* => Item_status2*
				item_status_content* / <= Item_status2*
				-
				ids_current => ids_current2
				spread_ids <= ids_current2
	tags /
		\drag
		\dragndrop
		\reorder
		\transfer
		\page
		\menu
		\navigation
	aspects /
		\Widget/Plugin
		\Drag'n'Drop

$yuf_drop_list_demo_catalog $mol_book2_catalog
	items_max 3
	menu_tools /
		<= Errors_on $mol_check_box
			title <= errors_on_title @ \Error
			checked? <=> errors_on? false
	menu_foot /$mol_view
		^
		^ status_content /$mol_view <= Status
		<= Foot_title $mol_view sub / \Footer
	menu_body /$mol_view
		<= Menu_filter
		<= Menu_links $yuf_drop_list
			item_pending* => item_pending*
			Item_status* => Item_status*
			Status => Status
			ids_current => ids_current
			-
			Empty <= Menu_links_empty
			param <= param
			-
			ids_actual? <=> ids_actual? /string
			-
			id* <= id* \
			ids_filtered <= spread_ids_filtered
			Item* <= Menu_item* $yuf_drop_list_demo_catalog_item sub /
				^ item_status_content* /$mol_view_content <= item_pending*
				^ menu_item_content*
	menu_link_content* /$mol_view_content
		<= Menu_link_title*
	spread_ids <= ids_actual
	spread_title* <= id*

$yuf_drop_list_demo_catalog_item $mol_view
