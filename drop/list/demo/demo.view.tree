$yuf_drop_list_demo $mol_example_large
	auto /
		^
		<= toggling_task null
	count? 0
	sub /
		<= Book $mol_book2 pages /
			- <= Catalog2 $yuf_drop_list_demo_catalog
				menu_title \DnD - Per item status
				param \dnd_per_item
				status_content /
				-
				Item_status* => Item_status2*
				item_status_content* / <= Item_status2*
				-
				ids_current => ids_current2
				spread_ids <= ids_current2
			<= Settings_page $mol_page body /
				<= Hide_pages $mol_check_box
					title <= hide_pages_title @ \Hide, show, drag to explore bug
					checked? <=> hided? false
				<= Toggling_check $mol_check_box
					title <= toggling_title @ \Auto hide/show to explore memory leaks
					checked? <=> toggling? false
				<= Every_field $mol_form_field
					name <= every_field_name \Long wait every counts
					content /
						<= Every_count $mol_number
							value? <=> every_count_wait? 100
				<= Short_wait_field $mol_form_field
					name <= short_wait_name \Short wait, ms
					content / <= Short_wait $mol_number
						value? <=> short_wait? 120
				<= Long_wait_field $mol_form_field
					name <= long_wait_name \Long wait, ms
					content / <= Long_wait $mol_number
						value? <=> long_wait? 30000
				<= Counter $mol_labeler
					title <= counter_title \Count
					content / <= count_msg <= waiting \waiting
				<= Cat_title $mol_status message <= cat_title - pull title to simulate catalog behaviour
			^ pages /$mol_view <= Catalog $yuf_drop_list_demo_catalog
				menu_title \DnD - status in top
				title => cat_title
				param \dnd
	tags /
		\drag
		\dragndrop
		\reorder
		\transfer
		\page
		\menu
		\navigation
	aspects /
		\Widget/Plugin
		\Drag'n'Drop

$yuf_drop_list_demo_catalog $mol_book2_catalog
	items_max 300
	menu_tools /
		<= Errors_on $mol_check_box
			title <= errors_on_title @ \Error
			checked? <=> errors_on? false
	menu_foot /$mol_view
		^
		^ status_content /$mol_view <= Status
		<= Foot_title $mol_view sub / \Footer
	menu_body /$mol_view
		<= Menu_filter
		<= Menu_links $yuf_drop_list
			item_pending* => item_pending*
			Item_status* => Item_status*
			Status => Status
			ids_current => ids_current
			-
			Empty <= Menu_links_empty
			param <= param
			-
			ids_actual? <=> ids_actual? /string
			-
			id* <= id* \
			ids_filtered <= spread_ids_filtered
			Item* <= Menu_item* $yuf_drop_list_demo_catalog_item sub /
				^ item_status_content* /$mol_view_content <= item_pending*
				^ menu_item_content*
	menu_link_content* /$mol_view_content
		<= Menu_link_title*
	spread_ids <= ids_actual
	spread_title* <= id*

$yuf_drop_list_demo_catalog_item $mol_view
